@page "/tunnels"
@using NewLife.Log
@using PortManager.Services
@using PortManager.Models

@using System.Threading.Tasks
@inject TunnelService TunnelService
@inject SettingsService SettingsService
@inject NavigationManager Navigation
@inject ThemeService ThemeService
@inject NotificationService NotificationService
@inject IJSRuntime JSRuntime
@inject HttpClient HttpClient

<PageTitle>隧道管理</PageTitle>

<NavigationMenu />

<div class="pa-2" style="width: 100%;">
    <MRow Dense Class="mb-2 align-center">
        <MCol Cols="12" Class="text-center" Style="position: relative;">
            <div style="display: inline-block; padding: 8px 24px; border: 2px solid transparent; border-image: linear-gradient(135deg, #667eea 0%, #764ba2 100%) 1; background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);">
                <h2 class="text-h5 font-weight-bold mb-0" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">隧道管理</h2>
                <div style="font-size: 11px; color: #a0a0a0; margin-top: 4px;">管理Cloudflare和LocalTunnel隧道 · v3.1</div>
            </div>
            @if (_tunnels.Count > 0)
            {
                <div class="d-flex align-center gap-2" style="position: absolute; right: 0; top: 50%; transform: translateY(-50%);">
                    <div class="d-flex align-center gap-1 px-2 py-1" style="background: var(--m-primary-color-4); border-radius: 12px;" title="隧道总数">
                        <MIcon XXSmall Color="primary">mdi-chart-bar</MIcon>
                        <span class="text-caption font-weight-bold primary--text">@_tunnels.Count</span>
                    </div>
                    <div class="d-flex align-center gap-1 px-2 py-1" style="background: var(--m-success-color-4); border-radius: 12px;" title="活动隧道">
                        <MIcon XXSmall Color="success">mdi-check-circle</MIcon>
                        <span class="text-caption font-weight-bold success--text">@_tunnels.Count(t => t.IsActive)</span>
                    </div>
                </div>
            }
        </MCol>
    </MRow>

    @if (_showNotification)
    {
        <MSnackbar Value="_showNotification" ValueChanged="@(v => _showNotification = v)" Color="@_notificationType" Timeout="3000" Bottom="true" Left="true">
            <MIcon Class="mr-2">@_notificationIcon</MIcon>
            @_notificationMessage
        </MSnackbar>
    }

    <MRow Class="mb-3" Dense>
        <MCol Cols="12">
            <MCard Elevation="0" Outlined Class="pa-2">
                <div class="d-flex flex-wrap align-center gap-2">
                    <div class="d-flex align-center gap-2">
                        <MIcon Small Color="primary">mdi-cloud</MIcon>
                        <span class="text-body2 font-weight-medium">Cloudflared</span>
                        @if (_cloudflaredStatus == null)
                        {
                            <MProgressCircular Indeterminate Size="16" />
                            <span class="text-caption">检查中...</span>
                        }
                        else if (_cloudflaredStatus.IsInstalled)
                        {
                            <MChip Small Color="success" Outlined>
                                <MIcon XSmall Left>mdi-check-circle</MIcon>
                                @_cloudflaredStatus.Version
                            </MChip>
                            @if (_isUpdatingCloudflared && _updateProgress != null)
                            {
                                <MProgressLinear Value="@_updateProgress.Progress" Style="width: 100px;" />
                            }
                            else if (_cloudflaredStatus.HasUpdate)
                            {
                                <MChip Small Color="warning" Outlined>
                                    <MIcon XSmall Left>mdi-arrow-up-bold</MIcon>
                                    新版本 @_cloudflaredStatus.LatestVersion
                                </MChip>
                                <MButton Color="warning" OnClick="@UpdateCloudflared" Disabled="@_isUpdatingCloudflared" Outlined>
                                    <MIcon Small Left>mdi-download</MIcon>
                                    升级
                                </MButton>
                            }
                            else
                            {
                                <MChip Small Color="info" Outlined>
                                    <MIcon XSmall Left>mdi-check</MIcon>
                                    已是最新
                                </MChip>
                            }
                        }
                        else
                        {
                            <MChip Small Color="error" Outlined>
                                <MIcon XSmall Left>mdi-close-circle</MIcon>
                                未安装
                            </MChip>
                            <MButton Color="info" OnClick="@ShowInstallGuide" Small Outlined>
                                <MIcon XSmall Left>mdi-help-circle</MIcon>
                                安装指南
                            </MButton>
                        }
                    </div>
                    <MSpacer></MSpacer>
                    <MButton Color="primary" OnClick="@RefreshTunnels" Outlined>
                        <MIcon Small Left>mdi-refresh</MIcon>
                        刷新
                    </MButton>
                    @if (_tunnels.Count > 0)
                    {
                        <MButton Color="error" OnClick="@StopAllTunnels" Outlined>
                            <MIcon Small Left>mdi-delete</MIcon>
                            全部删除
                        </MButton>
                    }
                </div>
            </MCard>
        </MCol>
    </MRow>



    @if (_tunnels.Count == 0)
    {
        <MRow class="justify-center mb-4" Dense>
            <MCol cols="12" sm="8" md="6" Class="text-center">
                <MCard Elevation="1" Class="pa-6 transition-swing" Hover>
                    <div class="d-flex flex-column align-center">
                        <div class="d-flex align-center justify-center rounded-circle mb-3" style="width: 64px; height: 64px; background: var(--m-surface-variant-color);">
                            <MIcon Size="32" Color="grey">mdi-earth-off</MIcon>
                        </div>
                        <p class="text-h6 font-weight-medium mb-1">无活动隧道</p>
                        <p class="text-body2 text--secondary mb-0">创建一个隧道来暴露本地端口</p>
                    </div>
                </MCard>
            </MCol>
        </MRow>
    }
    else
    {
        <MRow class="mb-4" Dense>
            @foreach (var tunnel in _tunnels)
            {
                <MCol cols="6" sm="4" md="3" lg="2" Style="display: flex;">
                    <TunnelCard 
                        Tunnel="tunnel" 
                        IsLightTheme="_isLightTheme"
                        OnCheckLinkStatus="CheckLinkStatus"
                        OnRestart="RestartTunnel"
                        OnStop="StopTunnel"
                        OnCopy="CopyToClipboard"
                        OnNameChanged="UpdateTunnelName" />
                </MCol>
            }
        </MRow>
    }

    <MRow Dense>
        <MCol cols="12" sm="6" md="4">
            <MCard Elevation="2" Class="transition-swing" Hover>
                <MCardTitle Class="py-3 px-4 d-flex align-center" Style="background: var(--m-success-color); color: white;">
                    <div class="d-flex align-center justify-center rounded-circle mr-3" style="width: 32px; height: 32px; background: rgba(255,255,255,0.2);">
                        <MIcon Small Color="white">mdi-plus</MIcon>
                    </div>
                    <span class="text-h6 font-weight-medium">创建新隧道</span>
                </MCardTitle>
                <MCardText Class="pa-4">
                    <MForm>
                        <MTextField
                            Label="端口号"
                            Type="number"
                            @bind-Value="_newTunnelPort"
                            Placeholder="输入要暴露的端口号"
                            Dense
                            HideDetails="true"
                            Class="mb-3"
                            PrependInnerIcon="mdi-numeric"
                            Outlined
                        />
                        <MTextField
                            Label="隧道名称 (可选)"
                            @bind-Value="_newTunnelName"
                            Placeholder="输入隧道名称"
                            Dense
                            HideDetails="true"
                            Class="mb-3"
                            PrependInnerIcon="mdi-tag"
                            Outlined
                        />
                        @if (_isCreatingTunnel)
                        {
                            <MButton Color="success" Disabled="true" Block Class="mt-2">
                                <MProgressCircular Indeterminate Size="16" Class="mr-2" />
                                创建中...
                            </MButton>
                        }
                        else
                        {
                            <div class="d-flex gap-2 mt-2" style="width: 100%;">
                                <MButton Color="primary" OnClick="@CreateTunnel" Small Style="flex: 1;">
                                    <MIcon XSmall Left>mdi-cloud</MIcon>
                                    Cloudflare
                                </MButton>
                                <MButton Color="success" OnClick="@(() => CreateTunnelWithProvider(TunnelProvider.LocalTunnel))" Small Style="flex: 1;">
                                    <MIcon XSmall Left>mdi-tunnel</MIcon>
                                    LocalTunnel
                                </MButton>
                            </div>
                        }
                    </MForm>
                </MCardText>
            </MCard>
        </MCol>
    </MRow>

    <!-- 配置路径信息 -->
    <MRow class="mt-2" Dense>
        <MCol cols="12">
            <div class="d-flex align-center justify-center gap-2 py-2 px-3" style="background: var(--m-surface-variant-color); border-radius: 8px; border: 1px dashed var(--m-border-color);">
                <MIcon XSmall Color="grey">mdi-folder-outline</MIcon>
                <span class="text-caption text--secondary">配置保存路径:</span>
                <code class="text-caption" style="background: rgba(0,0,0,0.1); padding: 2px 8px; border-radius: 4px; font-family: monospace;">@SettingsService.SettingsPath</code>
                <MButton Icon XSmall OnClick="@(() => CopyToClipboard(SettingsService.SettingsPath))" Title="复制路径">
                    <MIcon XSmall>mdi-content-copy</MIcon>
                </MButton>
                <MButton Icon XSmall OnClick="@OpenSettingsFolder" Title="打开文件夹">
                    <MIcon XSmall>mdi-folder-open</MIcon>
                </MButton>
            </div>
        </MCol>
    </MRow>

    @if (_showTunnelInfoBox)
    {
        <MRow class="mt-4" Dense>
            <MCol cols="12">
                <MAlert Type="@AlertTypes.Info" Dense Dismissible @bind-Value="_showTunnelInfoBox">
                    <div class="d-flex align-start gap-2">
                        <MIcon Small>mdi-lightbulb</MIcon>
                        <div>
                            <span class="text-body-2 font-weight-bold">一键发布至公网</span>
                            <span class="text-caption d-block">鼠标一点，即可将内网站点发布至公网，方便给客户演示、远程调试和协同开发</span>
                        </div>
                    </div>
                </MAlert>
            </MCol>
        </MRow>
    }
</div>

<!-- 安装指南对话框 -->
<MDialog @bind-Value="_showInstallGuide" MaxWidth="800" Persistent="false">
    <MCard>
        <MCardTitle>
            <MIcon Class="mr-2" Color="primary">mdi-download</MIcon>
            Cloudflared 安装指南
        </MCardTitle>
        <MCardText>
            <MTabs Value="_installGuideTab" ValueChanged="@(v => _installGuideTab = v.ToInt32())" Grow>
                <MTab>
                    <MIcon Small Left>mdi-microsoft-windows</MIcon>
                    Windows
                </MTab>
                <MTab>
                    <MIcon Small Left>mdi-linux</MIcon>
                    Linux
                </MTab>
                <MTab>
                    <MIcon Small Left>mdi-apple</MIcon>
                    macOS
                </MTab>
            </MTabs>

            <MTabsItems Value="_installGuideTab">
                <MTabItem>
                    <div class="pa-4">
                        <h3 class="text-h6 mb-3">Windows 安装方法</h3>
                        
                        <h4 class="text-subtitle-1 font-weight-bold mb-2">方法 1: 使用 Chocolatey (推荐)</h4>
                        <div class="code-block mb-3">choco install cloudflared</div>
                        
                        <h4 class="text-subtitle-1 font-weight-bold mb-2">方法 2: 使用 Scoop</h4>
                        <div class="code-block mb-3">scoop install cloudflared</div>
                        
                        <h4 class="text-subtitle-1 font-weight-bold mb-2">方法 3: 手动下载</h4>
                        <ol class="mb-3">
                            <li>访问 <a href="https://github.com/cloudflare/cloudflared/releases" target="_blank">GitHub Releases</a></li>
                            <li>下载 cloudflared-windows-amd64.exe</li>
                            <li>重命名为 cloudflared.exe</li>
                            <li>将文件放入 C:\Windows\System32 或添加到 PATH</li>
                        </ol>
                        
                        <h4 class="text-subtitle-1 font-weight-bold mb-2">验证安装</h4>
                        <div class="code-block">cloudflared --version</div>
                    </div>
                </MTabItem>

                <MTabItem>
                    <div class="pa-4">
                        <h3 class="text-h6 mb-3">Linux 安装方法</h3>
                        
                        <h4 class="text-subtitle-1 font-weight-bold mb-2">Debian/Ubuntu (推荐)</h4>
                        <div class="code-block mb-3"># 添加 Cloudflare 仓库
wget -q https://pkg.cloudflare.com/cloudflare-main.gpg -O /usr/share/keyrings/cloudflare-main.gpg
echo "deb [signed-by=/usr/share/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared $(lsb_release -cs) main" | sudo tee /etc/apt/sources.list.d/cloudflared.list

# 安装 cloudflared
sudo apt-get update && sudo apt-get install cloudflared</div>
                        
                        <h4 class="text-subtitle-1 font-weight-bold mb-2">CentOS/RHEL/Fedora</h4>
                        <div class="code-block mb-3"># 下载并安装
wget https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-x86_64.rpm
sudo rpm -i cloudflared-linux-x86_64.rpm</div>
                        
                        <h4 class="text-subtitle-1 font-weight-bold mb-2">通用方法 (适用于所有发行版)</h4>
                        <div class="code-block mb-3"># 下载最新版本
sudo wget https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64 -O /usr/local/bin/cloudflared

# 添加执行权限
sudo chmod +x /usr/local/bin/cloudflared

# 验证安装
cloudflared --version</div>
                        
                        <h4 class="text-subtitle-1 font-weight-bold mb-2">Arch Linux</h4>
                        <div class="code-block mb-3">yay -S cloudflared-bin
# 或
sudo pacman -S cloudflared</div>
                        
                        <h4 class="text-subtitle-1 font-weight-bold mb-2">验证安装</h4>
                        <div class="code-block">cloudflared --version</div>
                    </div>
                </MTabItem>

                <MTabItem>
                    <div class="pa-4">
                        <h3 class="text-h6 mb-3">macOS 安装方法</h3>
                        
                        <h4 class="text-subtitle-1 font-weight-bold mb-2">使用 Homebrew (推荐)</h4>
                        <div class="code-block mb-3">brew install cloudflared</div>
                        
                        <h4 class="text-subtitle-1 font-weight-bold mb-2">手动下载</h4>
                        <ol class="mb-3">
                            <li>访问 <a href="https://github.com/cloudflare/cloudflared/releases" target="_blank">GitHub Releases</a></li>
                            <li>下载 cloudflared-darwin-amd64.tgz (Intel) 或 cloudflared-darwin-arm64.tgz (Apple Silicon)</li>
                            <li>解压并移动到 PATH 目录</li>
                        </ol>
                        <div class="code-block mb-3"># 示例 (Intel Mac)
tar -xzf cloudflared-darwin-amd64.tgz
mv cloudflared /usr/local/bin/</div>
                        
                        <h4 class="text-subtitle-1 font-weight-bold mb-2">验证安装</h4>
                        <div class="code-block">cloudflared --version</div>
                    </div>
                </MTabItem>
            </MTabsItems>
        </MCardText>
        <MCardActions>
            <MSpacer></MSpacer>
            <MButton Color="primary" OnClick="@(() => _showInstallGuide = false)">
                关闭
            </MButton>
        </MCardActions>
    </MCard>
</MDialog>

@code {
    private List<CloudflareTunnel> _tunnels = new();
    private CloudflaredStatus? _cloudflaredStatus;
    private int _newTunnelPort;
    private string _newTunnelName = string.Empty;
    private bool _isCreatingTunnel = false;
    private bool _isUpdatingCloudflared = false;
    private CloudflaredUpdateProgress? _updateProgress;
    private bool _showNotification = false;
    private string _notificationMessage = string.Empty;
    private string _notificationType = string.Empty;
    private string _notificationIcon = string.Empty;
    private bool _showTunnelInfoBox = true;
    private System.Threading.Timer? _tunnelTimer;
    private bool _isInitialized = false;
    private bool _showInstallGuide = false;
    private int _installGuideTab = 0;
    private bool _isLightTheme => !ThemeService.IsDarkTheme;

    protected override async Task OnInitializedAsync()
    {
        _isInitialized = true;
        _tunnelTimer = new System.Threading.Timer(_ => UpdateTunnelStatus(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(5));

        // 订阅更新进度事件
        TunnelService.UpdateProgressChanged += OnUpdateProgressChanged;

        _ = Task.Run(async () =>
        {
            await TunnelService.InitializeAsync();
            await LoadTunnelsAsync();
            await InvokeAsync(() => StateHasChanged());
        });

        _ = Task.Run(async () =>
        {
            await ScanTunnelsAsync();
            await InvokeAsync(() => StateHasChanged());
        });

        _ = Task.Run(async () =>
        {
            await CheckCloudflaredStatus();
            await InvokeAsync(() => StateHasChanged());
        });
    }

    private void OnUpdateProgressChanged(object? sender, CloudflaredUpdateProgress progress)
    {
        _updateProgress = progress;
        InvokeAsync(() => StateHasChanged());
    }

    public void Dispose()
    {
        _tunnelTimer?.Dispose();
        TunnelService.UpdateProgressChanged -= OnUpdateProgressChanged;
    }

    private async Task LoadTunnelsAsync()
    {
        try
        {
            _tunnels = TunnelService.GetTunnels();
        }
        catch (Exception ex)
        {
            XTrace.Log.Error($"Error loading tunnels: {ex.Message}");
            ShowNotification("加载隧道失败", "error");
        }
    }

    private async Task RefreshTunnels()
    {
        try
        {
            _tunnels = TunnelService.GetTunnels();
            
            // 自动检测所有隧道的链接状态
            foreach (var tunnel in _tunnels.Where(t => !string.IsNullOrEmpty(t.TunnelUrl) && t.TunnelUrl != "Unknown"))
            {
                _ = CheckLinkStatus(tunnel);
            }
            
            ShowNotification("隧道已刷新", "success");
        }
        catch (Exception ex)
        {
            XTrace.Log.Error($"Error refreshing tunnels: {ex.Message}");
            ShowNotification("刷新隧道失败", "error");
        }
    }

    private async Task ScanTunnelsAsync()
    {
        try
        {
            var scannedTunnels = await TunnelService.ScanTunnelsAsync();
            if (scannedTunnels.Count > 0)
            {
                _tunnels = TunnelService.GetTunnels();
            }
        }
        catch (Exception ex)
        {
            XTrace.Log.Error($"Error scanning tunnels: {ex.Message}");
        }
    }

    private async Task CreateTunnel()
    {
        // 默认使用 Cloudflare
        await CreateTunnelWithProvider(TunnelProvider.Cloudflare);
    }

    private async Task CreateTunnelWithProvider(TunnelProvider provider)
    {
        if (string.IsNullOrWhiteSpace(_newTunnelPort.ToString()) || _newTunnelPort <= 0)
        {
            ShowNotification("请输入有效的端口号", "warning");
            return;
        }

        _isCreatingTunnel = true;
        StateHasChanged();

        try
        {
            var tunnel = await TunnelService.CreateTunnelAsync(_newTunnelPort, _newTunnelName, provider);
            
            // 等待一小段时间确保 URL 被解析
            await Task.Delay(500);
            
            _tunnels = TunnelService.GetTunnels();
            
            var providerName = provider.GetDisplayName();
            if (!string.IsNullOrEmpty(tunnel.TunnelUrl) && tunnel.TunnelUrl != "Unknown")
            {
                ShowNotification($"{providerName} 隧道已创建: {tunnel.TunnelUrl}", "success");
            }
            else
            {
                ShowNotification($"{providerName} 隧道创建成功，正在获取链接...", "success");
            }
            
            _newTunnelPort = 0;
            _newTunnelName = string.Empty;
        }
        catch (Exception ex)
        {
            XTrace.Log.Error($"Error creating {provider.GetDisplayName()} tunnel: {ex.Message}");
            ShowNotification($"创建 {provider.GetDisplayName()} 隧道失败: {ex.Message}", "error");
        }
        finally
        {
            _isCreatingTunnel = false;
            StateHasChanged();
        }
    }

    private async Task StopTunnel(int port)
    {
        try
        {
            TunnelService.StopTunnel(port);
            _tunnels = TunnelService.GetTunnels();
            ShowNotification($"端口 {port} 的隧道已停止", "success");
        }
        catch (Exception ex)
        {
            XTrace.Log.Error($"Error stopping tunnel: {ex.Message}");
            ShowNotification($"停止隧道失败: {ex.Message}", "error");
        }
    }

    private async Task RestartTunnel(CloudflareTunnel tunnel)
    {
        try
        {
            // 先停止原隧道
            TunnelService.StopTunnel(tunnel.Port);
            
            // 使用原来的 Provider 重新创建
            var newTunnel = await TunnelService.CreateTunnelAsync(tunnel.Port, tunnel.TunnelName, tunnel.Provider);
            _tunnels = TunnelService.GetTunnels();
            ShowNotification($"端口 {tunnel.Port} 的 {tunnel.Provider.GetDisplayName()} 隧道已重启", "success");
        }
        catch (Exception ex)
        {
            XTrace.Log.Error($"Error restarting tunnel: {ex.Message}");
            ShowNotification($"重启隧道失败: {ex.Message}", "error");
        }
    }

    private async Task StopAllTunnels()
    {
        try
        {
            TunnelService.StopAllTunnels();
            _tunnels.Clear();
            ShowNotification("所有隧道已停止", "success");
        }
        catch (Exception ex)
        {
            XTrace.Log.Error($"Error stopping all tunnels: {ex.Message}");
            ShowNotification($"停止所有隧道失败: {ex.Message}", "error");
        }
    }

    private async Task CheckCloudflaredStatus()
    {
        try
        {
            _cloudflaredStatus = await TunnelService.GetCloudflaredStatusWithUpdateCheckAsync();
        }
        catch (Exception ex)
        {
            XTrace.Log.Error($"Error checking cloudflared status: {ex.Message}");
        }
    }

    private async Task UpdateCloudflared()
    {
        _isUpdatingCloudflared = true;
        StateHasChanged();

        try
        {
            var newVersion = await TunnelService.UpdateCloudflaredAsync();
            _cloudflaredStatus = null;
            await CheckCloudflaredStatus();
            ShowNotification($"Cloudflared 已升级到 {newVersion}", "success");
        }
        catch (Exception ex)
        {
            XTrace.Log.Error($"Error updating cloudflared: {ex.Message}");
            ShowNotification($"升级失败: {ex.Message}", "error");
        }
        finally
        {
            _isUpdatingCloudflared = false;
            StateHasChanged();
        }
    }

    private void UpdateTunnelStatus()
    {
        if (!_isInitialized) return;

        try
        {
            TunnelService.UpdateTunnelStatus();
            _tunnels = TunnelService.GetTunnels();
            _ = InvokeAsync(() => StateHasChanged());
        }
        catch (Exception ex)
        {
            XTrace.Log.Error($"Error updating tunnel status: {ex.Message}");
        }
    }

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            ShowNotification("已复制到剪贴板", "success");
        }
        catch (Exception ex)
        {
            XTrace.Log.Error($"Error copying to clipboard: {ex.Message}");
            ShowNotification("复制失败", "error");
        }
    }

    private async Task OpenSettingsFolder()
    {
#if WINDOWS
        await Task.Run(() =>
        {
            try
            {
                var folderPath = Path.GetDirectoryName(SettingsService.SettingsPath);
                if (string.IsNullOrEmpty(folderPath)) return;

                var psi = new System.Diagnostics.ProcessStartInfo
                {
                    FileName = "explorer.exe",
                    Arguments = $"/select,\"{SettingsService.SettingsPath}\"",
                    UseShellExecute = true
                };
                System.Diagnostics.Process.Start(psi);
                
                InvokeAsync(() => ShowNotification("已打开文件夹", "success"));
            }
            catch (Exception ex)
            {
                XTrace.Log.Error($"Error opening folder: {ex.Message}");
                InvokeAsync(() => ShowNotification("打开文件夹失败", "error"));
            }
        });
#else
        await Task.CompletedTask;
        ShowNotification("此功能仅在 Windows 本地运行时可用", "warning");
#endif
    }

    private void ShowNotification(string message, string type = "success")
    {
        _notificationMessage = message;
        _notificationType = type;
        _notificationIcon = type switch
        {
            "success" => "✓",
            "error" => "✕",
            "warning" => "⚠",
            "info" => "ℹ",
            _ => "ℹ"
        };
        _showNotification = true;
        StateHasChanged();
    }

    private void UpdateTunnelName((int Port, string NewName) args)
    {
        var tunnel = _tunnels.FirstOrDefault(t => t.Port == args.Port);
        if (tunnel != null)
        {
            tunnel.TunnelName = args.NewName;
            // 保存到设置
            var tunnelsToSave = _tunnels.Select(t => new CloudflareTunnel
            {
                Port = t.Port,
                TunnelUrl = t.TunnelUrl,
                Status = t.Status,
                ProcessId = t.ProcessId,
                StartTime = t.StartTime,
                TunnelName = t.TunnelName
            }).ToList();
            SettingsService.SaveActiveTunnels(tunnelsToSave);
            ShowNotification("隧道名称已更新", "success");
        }
    }

