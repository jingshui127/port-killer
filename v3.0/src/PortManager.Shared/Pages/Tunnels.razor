    /// <summary>
    /// 检测链接状态
    /// </summary>
    private async Task CheckLinkStatus(CloudflareTunnel tunnel)
    {
        tunnel.LinkStatus = "Checking";
        tunnel.LastChecked = DateTime.Now;
        StateHasChanged();

        try
        {
            // 使用新的 HttpClient 实例并设置超时
            using var client = new HttpClient { Timeout = TimeSpan.FromSeconds(10) };
            
            // 尝试访问链接
            var response = await client.GetAsync(tunnel.TunnelUrl);
            
            if (response.IsSuccessStatusCode)
            {
                tunnel.LinkStatus = "Online";
                tunnel.LinkStatusMessage = null;
            }
            else if ((int)response.StatusCode >= 500)
            {
                // 5xx 错误表示服务器端问题（如 502 Bad Gateway）
                tunnel.LinkStatus = "Offline";
                tunnel.LinkStatusMessage = $"{(int)response.StatusCode} {response.StatusCode}";
            }
            else
            {
                tunnel.LinkStatus = "Error";
                tunnel.LinkStatusMessage = $"{(int)response.StatusCode} {response.StatusCode}";
            }
        }
        catch (HttpRequestException ex)
        {
            tunnel.LinkStatus = "Offline";
            tunnel.LinkStatusMessage = "无法连接";
            XTrace.WriteLine($"[Tunnels] Link check failed for {tunnel.TunnelUrl}: {ex.Message}");
        }
        catch (TaskCanceledException)
        {
            tunnel.LinkStatus = "Offline";
            tunnel.LinkStatusMessage = "连接超时";
        }
        catch (Exception ex)
        {
            tunnel.LinkStatus = "Error";
            tunnel.LinkStatusMessage = "检测失败";
            XTrace.Log.Error($"[Tunnels] Error checking link status: {ex.Message}");
        }
        
        StateHasChanged();
    }

    /// <summary>
    /// 获取相对时间文本
    /// </summary>
    private string GetTimeAgo(DateTime time)
    {
        var diff = DateTime.Now - time;
        
        if (diff.TotalDays >= 1)
            return $"{diff.TotalDays:F0}天前";
        if (diff.TotalHours >= 1)
            return $"{diff.TotalHours:F0}小时前";
        if (diff.TotalMinutes >= 1)
            return $"{diff.TotalMinutes:F0}分钟前";
        return $"{diff.TotalSeconds:F0}秒前";
    }
