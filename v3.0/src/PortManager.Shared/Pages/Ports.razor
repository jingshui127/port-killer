@page "/ports"
@using NewLife.Log
@using PortManager.Services
@using PortManager.Models
@using PortManager.Shared.Components
@using Masa.Blazor
@using System.Text
@using System.IO

<PageTitle>端口管理</PageTitle>

<NavigationMenu />

<div class="container @(IsLightTheme ? "light" : "")" style="width: 100%; max-width: 100%; height: calc(100vh - 28px); overflow: hidden;">
    <div class="pa-2" style="width: 100%; height: 100%; display: flex; flex-direction: column;">
        <!-- 固定头部区域 -->
        <div style="flex-shrink: 0;">
            <!-- 标题和状态信息行合并 - 标题居中，状态在右侧 -->
            <MRow Dense Class="mb-1 align-center">
                <MCol Cols="12" Class="text-center" Style="position: relative;">
                    <div style="display: inline-block; padding: 12px 32px; border: 2px solid transparent; border-image: linear-gradient(135deg, #667eea 0%, #764ba2 100%) 1; background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);">
                        <h2 class="text-h5 font-weight-bold mb-0" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">端口管理</h2>
                        <div style="font-size: 11px; color: #a0a0a0; margin-top: 4px;">查看和管理系统端口 · v3.0</div>
                    </div>
                    <div class="status-group-inline" style="position: absolute; right: 0; top: 50%; transform: translateY(-50%);">
                        @if (_autoRefreshEnabled)
                        {
                            <div class="status-badge auto-refresh-badge" title="自动刷新已开启">
                                <span class="pulse-dot"></span>
                                <span class="value">自动</span>
                            </div>
                        }
                        @if (_lastRefreshTime > DateTime.MinValue)
                        {
                            <div class="status-badge time-badge" title="最后刷新时间">
                                <span class="icon @(_isLoading || _isRefreshing || _refreshProgressTimer != null ? "spin" : "")">🕐</span>
                                <span class="value">@GetLastRefreshTimeText()</span>
                            </div>
                        }
                        @if (_isLoading || _isRefreshing || _refreshProgressTimer != null)
                        {
                            <div class="status-badge duration-badge active" title="刷新中...">
                                <span class="icon spin">⏱</span>
                                <span class="value">@GetCurrentRefreshDurationText()</span>
                            </div>
                        }
                        else if (_lastRefreshDuration > TimeSpan.Zero)
                        {
                            <div class="status-badge duration-badge" title="上次刷新耗时">
                                <span class="icon">⏱</span>
                                <span class="value">@GetRefreshDurationText()</span>
                            </div>
                        }
                        <div class="status-badge refresh-badge" title="刷新计数">
                            <span class="icon @(_isRefreshing ? "spin" : "")">⟳</span>
                            <span class="value">@_refreshCount</span>
                        </div>
                    </div>
                </MCol>
            </MRow>

            @if (_showNotification)
            {
                <div class="notification @_notificationType">
                    <span class="notification-icon">@_notificationIcon</span>
                    <span class="notification-message">@_notificationMessage</span>
                    <button class="notification-close" @onclick="@HideNotification">✕</button>
                </div>
            }

            <div class="actions-container">
        <!-- 操作按钮组 -->
        <div class="actions-group">
            <button class="btn btn-primary @(_isRefreshing ? "refreshing" : "")" @onclick="@RefreshPorts" disabled="@_isRefreshing">
                <span class="icon @(_isRefreshing ? "spin" : "")">↻</span>
                <text>@(_isRefreshing ? "刷新中..." : "刷新")</text>
            </button>
            <button class="btn btn-secondary" @onclick="@ToggleAutoRefresh" title="自动刷新">
                <span class="icon">@(_autoRefreshEnabled ? "⏸" : "▶")</span>
                <text>@(_autoRefreshEnabled ? "暂停" : "自动")</text>
            </button>
            <button class="btn btn-secondary" @onclick="@ShowNotificationHistory" title="通知历史">
                <span class="icon">🔔</span>
                <text>通知历史</text>
            </button>
            <button class="export-btn" @onclick="ExportToCsv" title="导出CSV">
                <span class="icon">📊</span>
                <text>CSV</text>
            </button>
            <button class="export-btn" @onclick="ExportToJson" title="导出JSON">
                <span class="icon">📋</span>
                <text>JSON</text>
            </button>
        </div>

        <!-- 批量操作组 -->
        @if (_selectedPorts.Count > 0)
        {
            <div class="batch-actions-group">
                <span class="selected-count">已选择 @_selectedPorts.Count 个端口</span>
                <button class="btn btn-danger" @onclick="@BatchKillPorts" title="批量终止">
                    <span class="icon">✕</span>
                    <text>终止选中</text>
                </button>
                <button class="btn btn-secondary" @onclick="@ClearSelection" title="清除选择">
                    <span class="icon">✕</span>
                    <text>清除</text>
                </button>
            </div>
        }
    </div>

    <div class="filter-search-container">
        <div class="filter-buttons">
            <button class="filter-btn @((!_showFavoritesOnly && !_showWatchedOnly && !_showSystemServicesOnly) ? "active" : "")" @onclick="@(() => ToggleFilter("all"))">
                <span class="icon">📋</span>
                <text>全部</text>
            </button>
            <button class="filter-btn @(_showFavoritesOnly ? "active" : "")" @onclick="@(() => ToggleFilter("favorites"))">
                <span class="icon">★</span>
                <text>收藏</text>
            </button>
            <button class="filter-btn @(_showWatchedOnly ? "active" : "")" @onclick="@(() => ToggleFilter("watched"))">
                <span class="icon">👁</span>
                <text>监控</text>
            </button>
            <button class="filter-btn @(_showSystemServicesOnly ? "active" : "")" @onclick="@(() => ToggleFilter("system"))">
                <span class="icon">🛡️</span>
                <text>系统</text>
            </button>
            <button class="filter-btn @(_showTcpOnly ? "active" : "")" @onclick="@(() => ToggleFilter("tcp"))">
                <span class="icon">🟢</span>
                <text>TCP</text>
            </button>
            <button class="filter-btn @(_showUdpOnly ? "active" : "")" @onclick="@(() => ToggleFilter("udp"))">
                <span class="icon">🟠</span>
                <text>UDP</text>
            </button>
            <button class="view-toggle-btn @(_isTableView ? "active" : "")" @onclick="@ToggleView" title="切换视图">
                <span class="icon">@(_isTableView ? "📋" : "▦")</span>
                <text>@(_isTableView ? "卡片" : "表格")</text>
            </button>
        </div>

        <div class="search-box">
            <input type="text" @bind="_searchText" placeholder="搜索端口、进程名或地址..." @oninput="OnSearchInput" />
            <span class="search-icon">🔍</span>
        </div>

        <div class="port-range-filter">
            <span class="range-label">端口范围:</span>
            <input type="number" @bind="_portRangeStart" placeholder="起始" min="1" max="65535" @oninput="OnPortRangeInput" />
            <span class="range-separator">-</span>
            <input type="number" @bind="_portRangeEnd" placeholder="结束" min="1" max="65535" @oninput="OnPortRangeInput" />
            <button class="clear-range-btn" @onclick="ClearPortRange" title="清除范围">✕</button>
        </div>
    </div>
    </div><!-- 固定头部区域结束 -->

    <!-- 可滚动内容区域 -->
    <div style="flex: 1; overflow-y: auto; min-height: 0;">
    <!-- 端口统计面板 - 移到可滚动区域 -->
    @if (!_isLoading && _ports.Count > 0)
    {
        var groupedStats = _ports.GroupBy(p => p.Port).ToList();
        var uniquePortCount = groupedStats.Count;
        var tcpPortCount = groupedStats.Count(g => g.Any(p => p.Protocol == "TCP"));
        var udpPortCount = groupedStats.Count(g => g.Any(p => p.Protocol == "UDP"));
        var bothProtocolCount = groupedStats.Count(g => g.Any(p => p.Protocol == "TCP") && g.Any(p => p.Protocol == "UDP"));
        var systemPortCount = groupedStats.Count(g => g.Any(p => IsSystemService(p.ProcessName)));
        var favoritePortCount = groupedStats.Count(g => g.Any(p => p.IsFavorite));

        <div class="stats-panel" style="flex-shrink: 0;">
            <div class="stat-item">
                <div class="stat-value">@uniquePortCount</div>
                <div class="stat-label">总端口</div>
            </div>
            <div class="stat-item">
                <div class="stat-value tcp">@tcpPortCount</div>
                <div class="stat-label">TCP</div>
            </div>
            <div class="stat-item">
                <div class="stat-value udp">@udpPortCount</div>
                <div class="stat-label">UDP</div>
            </div>
            <div class="stat-item">
                <div class="stat-value both">@bothProtocolCount</div>
                <div class="stat-label">TCP+UDP</div>
            </div>
            <div class="stat-item">
                <div class="stat-value system">@systemPortCount</div>
                <div class="stat-label">系统</div>
            </div>
            <div class="stat-item">
                <div class="stat-value favorite">@favoritePortCount</div>
                <div class="stat-label">收藏</div>
            </div>
            <div class="stat-bar-container">
                <div class="stat-bar-label">TCP/UDP 分布</div>
                <div class="stat-bar">
                    @{
                        var tcpOnlyCount = groupedStats.Count(g => g.Any(p => p.Protocol == "TCP") && !g.Any(p => p.Protocol == "UDP"));
                        var udpOnlyCount = groupedStats.Count(g => g.Any(p => p.Protocol == "UDP") && !g.Any(p => p.Protocol == "TCP"));
                        var bothCount = bothProtocolCount;
                        var totalPorts = uniquePortCount;
                        var tcpOnlyPercent = totalPorts > 0 ? (tcpOnlyCount * 100.0 / totalPorts) : 0;
                        var bothPercent = totalPorts > 0 ? (bothCount * 100.0 / totalPorts) : 0;
                        var udpOnlyPercent = totalPorts > 0 ? (udpOnlyCount * 100.0 / totalPorts) : 0;
                    }
                    <div class="stat-bar-segment tcp" style="width: @tcpOnlyPercent%" title="仅 TCP: @tcpOnlyCount"></div>
                    <div class="stat-bar-segment both" style="width: @bothPercent%" title="TCP+UDP: @bothCount"></div>
                    <div class="stat-bar-segment udp" style="width: @udpOnlyPercent%" title="仅 UDP: @udpOnlyCount"></div>
                </div>
                <div class="stat-bar-legend">
                    <span class="legend-item tcp">仅TCP @tcpOnlyCount</span>
                    <span class="legend-item both">TCP+UDP @bothCount</span>
                    <span class="legend-item udp">仅UDP @udpOnlyCount</span>
                </div>
            </div>
        </div>
    }

    @if (_isLoading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>正在扫描端口...</p>
        </div>
    }
    else if (_filteredPorts.Count == 0)
    {
        <div class="empty">
            <div class="empty-icon">☁</div>
            <h2>无活动端口</h2>
            <p>点击"刷新"按钮开始扫描</p>
        </div>
    }
    else
    {
        @if (_isTableView)
        {
            <div class="port-table-container" style="flex: 0 0 auto; display: flex; flex-direction: column;">
                <MDataTable Items="_tableItems"
                           Headers="_tableHeaders"
                           ItemsPerPage="15"
                           Class="port-data-table"
                           Dense
                           FixedHeader>
                    <ItemColContent>
                        @switch (context.Header.Value)
                        {
                            case nameof(PortTableItem.Port):
                                <span class="font-weight-bold">@context.Item.Port</span>
                                break;
                            case nameof(PortTableItem.Protocol):
                                @if (context.Item.Protocol == "TCP+UDP")
                                {
                                    <span class="protocol-badge both" title="同时支持 TCP 和 UDP">TCP+UDP</span>
                                }
                                else if (context.Item.Protocol == "TCP")
                                {
                                    <span class="protocol-badge tcp">TCP</span>
                                }
                                else
                                {
                                    <span class="protocol-badge udp">UDP</span>
                                }
                                break;
                            case nameof(PortTableItem.Direction):
                                @((MarkupString)context.Item.Direction)
                                break;
                            case nameof(PortTableItem.ProcessName):
                                <span>@context.Item.ProcessName</span>
                                @if (context.Item.IsSystemService)
                                {
                                    <span class="system-service-badge" title="系统进程">🛡️</span>
                                }
                                break;
                            case nameof(PortTableItem.Description):
                                <span class="description-text">@context.Item.Description</span>
                                break;
                            case nameof(PortTableItem.Command):
                                <span class="text-truncate" style="max-width: 200px; display: inline-block;">@context.Item.Command</span>
                                break;
                            case nameof(PortTableItem.Address):
                                <span>@context.Item.Address</span>
                                break;
                            case nameof(PortTableItem.User):
                                <span>@context.Item.User</span>
                                break;
                            case nameof(PortTableItem.Pid):
                                @if (context.Item.Pid.HasValue)
                                {
                                    <span>@context.Item.Pid</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                                break;
                            case "Actions":
                                <div class="table-actions">
                                    <MButton Icon Small OnClick="@(() => ToggleFavorite(context.Item.Port))" Title="收藏">
                                        <MIcon Color="@(context.Item.IsFavorite ? "amber" : "grey")">
                                            @(context.Item.IsFavorite ? "mdi-star" : "mdi-star-outline")
                                        </MIcon>
                                    </MButton>
                                    <MButton Icon Small OnClick="@(() => ToggleWatch(context.Item.Port))" Title="监控">
                                        <MIcon Color="@(context.Item.IsWatched ? "primary" : "grey")">
                                            @(context.Item.IsWatched ? "mdi-eye" : "mdi-eye-outline")
                                        </MIcon>
                                    </MButton>
                                    <MButton Icon Small OnClick="@(() => CreateTunnelForPort(context.Item.Port))" Title="@(context.Item.HasTunnel ? "已创建隧道" : "创建隧道")">
                                        <MIcon Color="@(context.Item.HasTunnel ? "success" : "grey")">
                                            @(context.Item.HasTunnel ? "mdi-link-variant" : "mdi-web")
                                        </MIcon>
                                    </MButton>
                                    <MButton Icon Small OnClick="@(() => ShowPortDetails(context.Item.PrimaryPort))" Title="查看详情">
                                        <MIcon Color="info">mdi-information</MIcon>
                                    </MButton>
                                    <MButton Icon Small Color="error" OnClick="@(() => KillPort(context.Item.Port))" Title="终止">
                                        <MIcon>mdi-close</MIcon>
                                    </MButton>
                                </div>
                                break;
                        }
                    </ItemColContent>
                </MDataTable>
            </div>
        }
        else
        {
            <div class="port-list">
                @{
                    var groupedPorts = _filteredPorts.GroupBy(p => p.Port).OrderBy(g => g.Key);
                }
                @foreach (var group in groupedPorts)
                {
                    var portNumber = group.Key;
                    var tcpPort = group.FirstOrDefault(p => p.Protocol == "TCP");
                    var udpPort = group.FirstOrDefault(p => p.Protocol == "UDP");
                    var primaryPort = tcpPort ?? udpPort;
                    var isSystemProcess = primaryPort != null && IsSystemService(primaryPort.ProcessName);

                    <PortCard 
                        PortNumber="portNumber"
                        TcpPort="tcpPort"
                        UdpPort="udpPort"
                        IsSelected="_selectedPorts.Contains(portNumber)"
                        IsSystemProcess="isSystemProcess"
                        IsLightTheme="IsLightTheme"
                        SystemServiceDescription="@(primaryPort != null ? GetSystemServiceDescription(primaryPort.ProcessName) : "")"
                        GetPortUsageDescription="GetPortUsageDescription"
                        GetAccessDirectionArrow="GetAccessDirectionArrow"
                        OnSelect="TogglePortSelection"
                        OnToggleFavorite="ToggleFavorite"
                        OnToggleWatch="ToggleWatch"
                        OnCreateTunnel="CreateTunnelForPort"
                        OnShowDetails="ShowPortDetails"
                        OnKillPort="KillPort" />
                }
            </div>
        }
    }
    </div><!-- 可滚动内容区域结束 -->
</div><!-- pa-2 div 结束 -->
</div><!-- container div 结束 -->

@if (_showPortDetailsModal && _selectedPort != null)
{
    var processDetails = GetProcessDetails(_selectedPort.Pid);
    var isSystemProcess = IsSystemService(_selectedPort.ProcessName);
    var canKill = _selectedPort.Pid > 4 && !isSystemProcess;

    <div class="modal-overlay" @onclick="ClosePortDetailsModal">
        <div class="modal-content port-details-modal" @onclick:stopPropagation>
            <div class="modal-header">
                <h2><span class="icon">📋</span> 进程详情</h2>
                <button class="modal-close" @onclick="ClosePortDetailsModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="detail-section">
                    <div class="detail-row">
                        <span class="detail-label">端口</span>
                        <span class="detail-value">@_selectedPort.Port</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">协议</span>
                        <span class="detail-value">@_selectedPort.Protocol</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">PID</span>
                        <span class="detail-value">@_selectedPort.Pid @(isSystemProcess ? "🛡️" : "")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">进程</span>
                        <span class="detail-value">@_selectedPort.ProcessName</span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_selectedPort.Command))
                {
                    <div class="detail-section">
                        <div class="detail-label">路径</div>
                        <div class="path-box" title="@_selectedPort.Command">@_selectedPort.Command</div>
                    </div>
                }

                @if (processDetails != null)
                {
                    <div class="detail-section">
                        <div class="detail-row">
                            <span class="detail-label">内存</span>
                            <span class="detail-value">@FormatMemory(processDetails.MemoryKB)</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">CPU</span>
                            <span class="detail-value @GetCpuClass(processDetails.CpuPercent)">@processDetails.CpuPercent.ToString("F1")%</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">优先级</span>
                            <span class="detail-value">@processDetails.Priority</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">启动时间</span>
                            <span class="detail-value">@processDetails.StartTime</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">子进程</span>
                            <span class="detail-value">@processDetails.ChildrenCount processes</span>
                        </div>
                    </div>
                }

                <div class="detail-section">
                    <div class="detail-row">
                        <span class="detail-label">状态</span>
                        <span class="detail-value @GetStatusClass(processDetails?.ProcessStatus)">
                            @GetStatusText(processDetails?.ProcessStatus, canKill)
                        </span>
                    </div>
                </div>
            </div>

            <div class="modal-actions">
                @if (!string.IsNullOrEmpty(_selectedPort.Command))
                {
                    <button class="action-btn" @onclick="@(() => { _ = OpenProcessFolder(_selectedPort.Command); })">
                        <span class="icon">📁</span> 打开文件夹
                    </button>
                }
                <button class="action-btn" @onclick="@(() => { _ = OpenTaskManager(_selectedPort.Pid); })">
                    <span class="icon">📊</span> 任务管理器
                </button>
            </div>

            <div class="modal-footer">
                <button class="btn btn-primary" @onclick="@(() => { var port = _selectedPort?.Port ?? 0; ClosePortDetailsModal(); CreateTunnelForPort(port); })">
                    <span class="icon">🌐</span> 创建隧道
                </button>
                <button class="btn btn-danger" @onclick="@(() => { var port = _selectedPort?.Port ?? 0; ClosePortDetailsModal(); KillPort(port); })" disabled="@(!canKill)">
                    <span class="icon">✕</span> 终止进程
                </button>
            </div>
        </div>
    </div>
}

@if (_showNotificationHistoryModal)
{
    <div class="modal-overlay" @onclick="CloseNotificationHistoryModal">
        <div class="modal-content notification-history-modal" @onclick:stopPropagation>
            <div class="modal-header">
                <h2>通知历史</h2>
                <button class="modal-close" @onclick="CloseNotificationHistoryModal">✕</button>
            </div>
            <div class="modal-body">
                @if (_notificationHistory.Count == 0)
                {
                    <div class="empty-history">
                        <span class="empty-icon">📭</span>
                        <p>暂无通知历史</p>
                    </div>
                }
                else
                {
                    <div class="notification-history-list">
                        @foreach (var notification in _notificationHistory)
                        {
                            <div class="notification-history-item @notification.Type">
                                <div class="notification-history-header">
                                    <span class="notification-history-icon">@notification.Icon</span>
                                    <span class="notification-history-message">@notification.Message</span>
                                    <span class="notification-history-time">@notification.Timestamp.ToString("HH:mm:ss")</span>
                                </div>
                                @if (!string.IsNullOrEmpty(notification.Details))
                                {
                                    <div class="notification-history-details">@notification.Details</div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="@ClearNotificationHistory">
                    <span class="icon">🗑</span>
                    <text>清除历史</text>
                </button>
            </div>
        </div>
    </div>
}

@* 隧道提供商选择对话框 *@
@if (_showTunnelProviderDialog)
{
    <div class="modal-overlay" @onclick="CancelCreateTunnel">
        <div class="modal-content provider-dialog" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 style="color: #2196F3;">选择隧道提供商</h3>
                <button class="btn-close" @onclick="CancelCreateTunnel">✕</button>
            </div>
            <div class="modal-body">
                <p class="dialog-description">为端口 <strong>@_pendingTunnelPort</strong> 创建临时隧道</p>

                <div class="provider-options">
                    <label class="provider-option @(_selectedTunnelProvider == TunnelProvider.Cloudflare ? "selected" : "")">
                        <input type="radio" name="provider" value="@TunnelProvider.Cloudflare"
                               checked="@(_selectedTunnelProvider == TunnelProvider.Cloudflare)"
                               @onchange="@(() => _selectedTunnelProvider = TunnelProvider.Cloudflare)" />
                        <div class="provider-info">
                            <div class="provider-name">Cloudflare</div>
                            <div class="provider-desc">trycloudflare.com - 快速稳定</div>
                        </div>
                    </label>

                    <label class="provider-option @(_selectedTunnelProvider == TunnelProvider.LocalTunnel ? "selected" : "")">
                        <input type="radio" name="provider" value="@TunnelProvider.LocalTunnel"
                               checked="@(_selectedTunnelProvider == TunnelProvider.LocalTunnel)"
                               @onchange="@(() => _selectedTunnelProvider = TunnelProvider.LocalTunnel)" />
                        <div class="provider-info">
                            <div class="provider-name">LocalTunnel</div>
                            <div class="provider-desc">loca.lt - 简单易用</div>
                        </div>
                    </label>
                </div>

                @if (_selectedTunnelProvider == TunnelProvider.LocalTunnel && !TunnelService.IsLocalTunnelInstalled())
                {
                    <div class="install-hint">
                        <span class="icon">⚠</span>
                        <span>LocalTunnel 未安装，请先运行: <code>npm install -g localtunnel</code></span>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CancelCreateTunnel">取消</button>
                <button class="btn btn-primary" @onclick="ConfirmCreateTunnel"
                        disabled="@(_selectedTunnelProvider == TunnelProvider.LocalTunnel && !TunnelService.IsLocalTunnelInstalled())">
                    <span class="icon">🌐</span>
                    <text>创建隧道</text>
                </button>
            </div>
        </div>
    </div>
}